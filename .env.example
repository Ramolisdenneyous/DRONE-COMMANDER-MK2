# Drone Commander MK2 — local environment template
# Copy to .env and fill in API keys before running docker compose.
# Ports differ from MK1 so both stacks can run side by side.

DATABASE_URL=postgresql+psycopg://drone:drone@postgres:5432/drone_commander_mk2
LLM_PROVIDER=openai
LLM_EXTERNAL_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_TACTICAL=gpt-5.6-luna
LLM_MODEL_RADIO=gpt-5.6-luna
LLM_DECISION_TIMEOUT_SEC=20
LOG_LEVEL=INFO
# metadata | full_diagnostic
ARTIFACT_RETENTION_MODE=metadata
VITE_API_BASE=http://localhost:8006
